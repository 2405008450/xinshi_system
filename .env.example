# 应用及数据库配置
SECRET_KEY=change-me
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xinshi_system

# 稿件安排邮件配置
# disabled：禁用；test：所有邮件只发到 SMTP_TEST_RECIPIENT；live：发送到页面选择的内部用户邮箱
# 常见组合：465 + ssl，或 587 + starttls。SMTP_PASSWORD 应填写邮箱服务商生成的 SMTP 授权码，不建议填写网页登录密码。
SMTP_MODE=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=信实翻译
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=15
SMTP_TEST_RECIPIENT=test@example.com
