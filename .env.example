# 应用及数据库配置
APP_ENV=development
# 常驻 API 必须保持关闭；仅执行本地迁移工具时在当前终端临时开启
LOCAL_SCHEMA_MIGRATIONS_ENABLED=false
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=480
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_NAME=xinshi_system
CORS_ALLOWED_ORIGINS=
FRONTEND_PORT=3000
# 前后端使用分号分隔的企业受控 UNC 根目录，例如：\\fileserver\projects;\\fileserver\resumes
VITE_OPENPATH_ALLOWED_ROOTS=
OPENPATH_ALLOWED_ROOTS=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=60000

# SMTP 授权码等可逆凭据的 AES-256-GCM 密钥。请生成随机 32 字节密钥并进行 Base64 编码，部署后必须随数据库备份。
CREDENTIAL_ENCRYPTION_ACTIVE_VERSION=v1
CREDENTIAL_ENCRYPTION_KEYS={"v1":"请替换为32字节随机密钥的Base64编码"}

# 登录安全：账号/IP 双维度滑动窗口限流
# AUTH_THROTTLE_HMAC_KEY 应使用与 JWT 不同的高强度随机密钥；留空时仅为兼容旧部署而回退 SECRET_KEY。
AUTH_THROTTLE_HMAC_KEY=change-me-with-an-independent-random-secret
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_FAILURE_LIMIT=5
AUTH_LOGIN_SOURCE_FAILURE_LIMIT=30
AUTH_LOGIN_BASE_BLOCK_SECONDS=60
AUTH_LOGIN_MAX_BLOCK_SECONDS=900
AUTH_LOGIN_ESCALATION_RESET_SECONDS=3600
AUTH_LOGIN_AUDIT_RETENTION_DAYS=90
AUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# 登录图形验证码：账号或来源 IP 在限流窗口内失败达到阈值后才要求输入，日常登录无感知。
AUTH_LOGIN_CAPTCHA_THRESHOLD=2
AUTH_LOGIN_CAPTCHA_TTL_SECONDS=120
AUTH_LOGIN_CAPTCHA_ISSUE_LIMIT_PER_MINUTE=10

# 公共 SMTP 与稿件安排固定发件邮箱配置
# PROJECT_MAIL_SENDER_MODE=system 时项目邮件也使用固定账号；personal 时项目邮件使用当前用户已验证的个人凭据。
# disabled：禁用；test：所有邮件只发到 SMTP_TEST_RECIPIENT；live：发送到业务指定收件邮箱。
# 常见组合：465 + ssl，或 587 + starttls。SMTP_PASSWORD 应填写邮箱服务商生成的 SMTP 授权码，不建议填写网页登录密码。
PROJECT_MAIL_SENDER_MODE=system
SMTP_MODE=disabled
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=sender@example.com
SMTP_FROM_NAME=信实翻译
SMTP_REPLY_TO=
SMTP_TIMEOUT_SECONDS=15
SMTP_TEST_RECIPIENT=test@example.com
MAIL_INLINE_IMAGE_DIR=data/mail_inline_images
ANNOTATION_CUSTOM_FIELD_IMAGE_DIR=data/annotation_custom_field_images
